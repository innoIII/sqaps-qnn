# ==============================================================
# Live Lecture AI Question Portal & Dashboard - Environment Variables
# ==============================================================

# AI Provider Configuration: 'gemini' | 'openai' | 'fallback'
AI_PROVIDER="gemini"

# GEMINI_API_KEY: Required for Gemini AI models (e.g. gemini-3.8-flash)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Model to use
AI_MODEL="gemini-3.8-flash"

# Optional: OpenAI Configuration (if AI_PROVIDER="openai")
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Usage and Rate Limiting Guardrails
AI_MAX_REQUESTS_PER_SESSION=25
AI_MAX_TOKENS=1000

# Server & Application Hosting
PORT=3000
APP_URL="MY_APP_URL"
NEXT_PUBLIC_APP_URL="MY_APP_URL"

# Optional: Database URL for Prisma / PostgreSQL integration
DATABASE_URL="postgresql://user:password@localhost:5432/live_lecture?schema=public"
